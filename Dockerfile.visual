FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:a0f4498920a5dbac63196d9140ed738ef00470f27e2e74029abd8850b7bd5717
# The browser image ships Node 24.20; use the same exact Node as development/CI.
RUN curl -fsSLO https://nodejs.org/dist/v24.21.0/node-v24.21.0-linux-arm64.tar.gz \
    && echo "724282c3b43aec998aa9527380465b45d229e021b58035f5f4f63095eabfe5d5  node-v24.21.0-linux-arm64.tar.gz" | sha256sum -c - \
    && tar -xzf node-v24.21.0-linux-arm64.tar.gz -C /usr/local --strip-components=1 \
    && rm node-v24.21.0-linux-arm64.tar.gz \
    && npm install --global pnpm@12.3.4
WORKDIR /workspace
ENV CI=true STORYBOOK_DISABLE_TELEMETRY=1 FRAME_UI_VISUAL=1
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .node-version ./
RUN test "$(node --version)" = "v$(cat .node-version)" && pnpm install --frozen-lockfile
COPY . .
CMD ["pnpm", "exec", "playwright", "test"]
