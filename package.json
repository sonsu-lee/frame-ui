{
  "name": "frame-ui",
  "version": "0.0.0",
  "private": true,
  "description": "React and StyleX UI primitives",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": ["dist"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "build": "vite build && tsc --project tsconfig.build.json",
    "check": "pnpm typecheck && pnpm build",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@stylexjs/stylex": "0.19.0",
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "unplugin": "2.3.11",
    "vite": "8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonsu-lee/frame-ui.git"
  }
}
